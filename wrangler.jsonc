// Cloudflare Workers: o app sai do build estático do SvelteKit (adapter-static, pasta build/);
// só /api/* passa pelo Worker (worker/index.ts), que guarda o progresso por nome no D1.
{
	"name": "cgu",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		// Mesmo papel do fallback index.html do adapter: rota desconhecida cai no app.
		"not_found_handling": "single-page-application",
		// Sem reescrita de .html: o Cloudflare redirecionaria missoes.html → missoes, e o service
		// worker guarda (e serve offline) as páginas de artefato pelo nome com .html.
		"html_handling": "none",
		"run_worker_first": ["/api/*"]
	},
	// Sem database_id: o wrangler cria o banco "cgu" no primeiro deploy e o reaproveita depois.
	"d1_databases": [{ "binding": "DB", "database_name": "cgu" }],
	// O cron do lembrete de estudo (planos/2026-10-17-notificacoes-de-estudo.md, fase 2): roda à
	// hora cheia e trata as inscrições da hora de Brasília.
	"triggers": { "crons": ["0 * * * *"] },
	// VAPID_PUBLICA vazia até a fase 4 (chaves de produção): o GET /api/lembrete responde 503 e o
	// cron não envia. O assunto é URL (não mailto:) para não pôr e-mail no repositório.
	"vars": { "VAPID_PUBLICA": "", "VAPID_ASSUNTO": "https://cgu.solarpunk.workers.dev" }
}
